{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factpack.local/schemas/event.schema.json",
  "title": "Event record (one JSONL line)",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "date": { "$ref": "common.schema.json#/$defs/iso_date" },
    "type": { "enum": ["merger", "acquisition", "divestiture", "enforcement", "litigation", "leadership", "capital_action", "product_launch", "partnership", "breach", "rating_action", "results", "guidance", "regulatory", "other"] },
    "entity_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" } },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string" },
    "source_ptr": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_ptr" } },
    "epistemic_status": { "$ref": "common.schema.json#/$defs/epistemic_status" },
    "as_of": { "$ref": "common.schema.json#/$defs/iso_date" }
  },
  "required": ["id", "date", "type", "entity_ids", "title", "source_ptr", "epistemic_status", "as_of"],
  "additionalProperties": false
}
