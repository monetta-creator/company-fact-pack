{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factpack.local/schemas/brief.schema.json",
  "title": "Brief frontmatter",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": "string", "minLength": 3 },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" } },
    "as_of": { "$ref": "common.schema.json#/$defs/iso_date" },
    "epistemic_status": { "$ref": "common.schema.json#/$defs/epistemic_status" },
    "review_by": { "$ref": "common.schema.json#/$defs/iso_date" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_ptr" } },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  },
  "required": ["id", "title", "entities", "as_of", "epistemic_status", "review_by", "sources"],
  "additionalProperties": false
}
