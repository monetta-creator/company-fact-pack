{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factpack.local/schemas/manifest.schema.json",
  "title": "Corpus document manifest",
  "type": "object",
  "properties": {
    "doc_id": { "type": "string", "minLength": 3 },
    "source": { "type": "string", "minLength": 2 },
    "source_tier": { "enum": ["A", "B", "C"] },
    "doc_type": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string", "description": "Origin URL, or 'user-provided' for inbox ingests" },
    "retrieved_at": { "$ref": "common.schema.json#/$defs/iso_datetime" },
    "filed_date": { "anyOf": [{ "$ref": "common.schema.json#/$defs/iso_date" }, { "type": "null" }] },
    "period_start": { "anyOf": [{ "$ref": "common.schema.json#/$defs/iso_date" }, { "type": "null" }] },
    "period_end": { "anyOf": [{ "$ref": "common.schema.json#/$defs/iso_date" }, { "type": "null" }] },
    "entity_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" } },
    "fetcher": { "type": "string", "description": "script name + version that wrote this doc" },
    "extraction_method": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "enum": ["raw", "extracted", "exhibit", "sidecar"] },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0 },
          "stored": {
            "enum": ["corpus", "cache"],
            "description": "cache = >25MB raw kept in build/cache; hash here is its provenance proof"
          }
        },
        "required": ["name", "role", "sha256", "stored"],
        "additionalProperties": false
      }
    },
    "meta": { "type": "object", "description": "Source-specific extras (accession no, form type, item codes...)" }
  },
  "required": ["doc_id", "source", "source_tier", "doc_type", "url", "retrieved_at", "entity_ids", "fetcher", "files"],
  "additionalProperties": false
}
